# NestJS API. Only /api/public/* is proxied through this site.
API_URL=http://localhost:4000

# Staff/customer web app, used by the "Sign in" link. Empty hides the link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional sub-path deployment (set at build time)
NEXT_BASE_PATH=

# --- Read at build time ---
# Public URL including any base path. While empty, the site is marked noindex.
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 measurement id (G-XXXXXXXXXX). Loads only after a visitor allows it.
NEXT_PUBLIC_GA_ID=
# Google Search Console "HTML tag" verification token (the content value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
