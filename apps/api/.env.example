# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_room?schema=public"

# --- HTTP ---
PORT=4000
# Origins allowed to call the API directly (the web app normally proxies /api through Next.js, so CORS is rarely needed)
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app — used in password reset links
WEB_URL=http://localhost:3000

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Predefined admin (upserted on every API start; changing the password here updates it)
ADMIN_EMAIL=admin@gameroom.local
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Administrator

# --- PCs / desktop client ---
# Shared secret every desktop client must send in the x-pc-key header
PC_AGENT_KEY=change-me-pc-key
# PCs 1..PC_COUNT are created automatically
PC_COUNT=10
# Seconds between desktop heartbeats (the desktop app uses 60)
HEARTBEAT_INTERVAL_SECONDS=60
# A PC is "online" if it sent a heartbeat within this many seconds
PC_ONLINE_WINDOW_SECONDS=150
# An ACTIVE session with no heartbeat for this long is closed (reason TIMEOUT)
SESSION_TIMEOUT_SECONDS=180
# LOW_BALANCE alert is raised once per session when balance drops to/below this
LOW_BALANCE_THRESHOLD_SECONDS=300

# --- Reports ---
APP_TIMEZONE=Asia/Tbilisi

# --- Mail (optional). If SMTP_HOST is empty, reset links are printed to the API log ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Game Room <no-reply@gameroom.local>"
